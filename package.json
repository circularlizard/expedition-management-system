{
  "name": "seee-expedition-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:php": "composer --working-dir=plugins/ems-plugin exec phpunit",
    "test:php:ems": "composer --working-dir=plugins/ems-plugin exec phpunit",
    "stan": "composer --working-dir=plugins/ems-plugin exec -- phpstan analyse --memory-limit=2G",
    "stan:ems": "composer --working-dir=plugins/ems-plugin exec -- phpstan analyse --memory-limit=2G",
    "verify:all": "npm run test && npm run build && npm run test:php && npm run stan",
    "deploy": "bash bin/deploy.sh ems",
    "deploy:ems": "bash bin/deploy.sh ems",
    "package": "bash bin/package.sh ems",
    "package:ems": "bash bin/package.sh ems",
    "package:all": "bash bin/package.sh all"
  }
}
